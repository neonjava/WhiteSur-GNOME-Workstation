configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
}

* {
    font: "Cantarell 15";
    background-color: #222633ff;
    text-color: #f4f5f8ff;
    border-color: #7d849955;
}

window {
    location: center;
    anchor: center;
    width: 640px;
    border: 1px;
    border-radius: 20px;
    padding: 16px;
    background-color: #222633ff;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
    background-color: #222633ff;
}

inputbar {
    children: [ prompt, entry ];
    padding: 12px;
    border-radius: 11px;
    background-color: #303645ff;
}

prompt {
    str: "⌕";
    padding: 0px 12px 0px 0px;
    text-color: #89b4faff;
}

entry {
    placeholder: "Search applications";
    placeholder-color: #aeb5c5ff;
    text-color: #f4f5f8ff;
    background-color: #303645ff;
}

listview {
    lines: 7;
    columns: 1;
    fixed-height: false;
    spacing: 3px;
    scrollbar: false;
    background-color: #222633ff;
}

element {
    padding: 10px;
    spacing: 10px;
    border-radius: 9px;
    background-color: #222633ff;
    text-color: #f4f5f8ff;
}

element selected {
    background-color: #5575a5ff;
    text-color: #ffffffff;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    background-color: transparent;
}

element-icon {
    size: 28px;
    background-color: transparent;
}
